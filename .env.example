# Canonical public HTTPS origin. No path, query, fragment, or credentials.
PUBLIC_URL=https://memory-mcp.example.com

# Random 32+ character secret used by Better Auth. Never commit the real value.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret

# SQLite file for OAuth and authentication state only.
DATABASE_PATH=/data/oauth.sqlite

# Private AgentMemory origin. Do not expose this URL to MCP clients.
AGENTMEMORY_URL=http://agentmemory.example.internal:3111

# Backend bearer for AgentMemory. Never send this to MCP clients.
AGENTMEMORY_SECRET=replace-with-the-agentmemory-backend-secret

# Comma-separated MCP tool allowlist.
ALLOWED_TOOLS=memory_recall,memory_smart_search,memory_save

# Listen port. Railway sets this automatically.
PORT=8080

# Seed-only. Generate a strong password in 1Password, run npm run seed-admin once,
# then remove both values from the environment.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
